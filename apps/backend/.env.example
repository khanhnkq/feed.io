# Feed.io Backend — DEVELOPMENT template (copy thành apps/backend/.env)
# Giá trị secret lấy từ root .env (do scripts/ensure-local-env.sh sinh ra).
# Chạy host dev: BE ở http://localhost:8000, Postgres/Valkey/RabbitMQ/Garage/Mailpit ở localhost.

FEEDIO_ENVIRONMENT=development
FEEDIO_DATABASE_URL=postgresql+psycopg://feedio:replace-with-postgres-password@localhost:5432/feedio
FEEDIO_VALKEY_URL=redis://localhost:6379/0
FEEDIO_RABBITMQ_URL=amqp://feedio:replace-with-rabbitmq-password@localhost:5672/
FEEDIO_GARAGE_ADMIN_URL=http://localhost:3903
FEEDIO_GARAGE_ADMIN_TOKEN=replace-me
FEEDIO_GARAGE_S3_ENDPOINT_URL=http://localhost:3900
FEEDIO_GARAGE_S3_BUCKET=feedio-media
FEEDIO_GARAGE_S3_ACCESS_KEY=replace-me
FEEDIO_GARAGE_S3_SECRET_KEY=replace-me
FEEDIO_GARAGE_S3_REGION=garage
FEEDIO_GARAGE_S3_CORS_ORIGINS='["http://localhost:3000","http://localhost:8088"]'
FEEDIO_AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
FEEDIO_AUTH_JWT_ISSUER=feedio
FEEDIO_AUTH_ACCESS_TTL_SECONDS=300
FEEDIO_AUTH_REFRESH_TTL_SECONDS=2592000
FEEDIO_AUTH_COOKIE_SECURE=false
FEEDIO_WEB_BASE_URL=http://localhost:3000

# Email Service Configuration (Default: Local Mailpit)
# Supports: Mailpit, Resend, Brevo, Gmail, SendGrid, Amazon SES, Stalwart
FEEDIO_SMTP_HOST=localhost
FEEDIO_SMTP_PORT=1025
FEEDIO_SMTP_SENDER="Feed.io <no-reply@feedio.local>"
FEEDIO_SMTP_USER=
FEEDIO_SMTP_PASS=
FEEDIO_SMTP_START_TLS=false
FEEDIO_SMTP_USE_TLS=false

# Presets for external free SMTP:
# Resend: host=smtp.resend.com, port=465, user=resend, pass=re_..., use_tls=true
# Brevo:  host=smtp-relay.brevo.com, port=587, user=email, pass=master_key, start_tls=true
# Gmail:  host=smtp.gmail.com, port=587, user=gmail, pass=16_char_app_password, start_tls=true

FEEDIO_CORS_ORIGINS='["http://localhost:3000","http://localhost:8088"]'
FEEDIO_COLLABORATION_PRESENCE_TTL_SECONDS=120
FEEDIO_COLLABORATION_PING_INTERVAL_SECONDS=25
FEEDIO_DEPENDENCY_TIMEOUT_SECONDS=2.0
FEEDIO_WORKER_METRICS_PORT=9101
FEEDIO_WORKER_PROBE_INTERVAL_SECONDS=10.0

# Billing & Payments
FEEDIO_BILLING_PROVIDER=mock
FEEDIO_PAYMENTS_ENABLED=true
FEEDIO_STRIPE_SECRET_KEY=
FEEDIO_STRIPE_WEBHOOK_SECRET=
FEEDIO_STRIPE_PRICE_PRO_100GB_MONTHLY=
FEEDIO_STRIPE_PRICE_PRO_100GB_YEARLY=
FEEDIO_STRIPE_PRICE_PRO_500GB_MONTHLY=
FEEDIO_STRIPE_PRICE_PRO_500GB_YEARLY=
FEEDIO_STRIPE_PRICE_PRO_1TB_MONTHLY=
FEEDIO_STRIPE_PRICE_PRO_1TB_YEARLY=
