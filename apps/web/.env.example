# Feed.io Web — DEVELOPMENT template (copy thành apps/web/.env.development)
# Host dev: web http://localhost:3000, API http://localhost:8000.
# Docker full-stack qua Nginx: NEXT_PUBLIC_API_URL=http://localhost:8088, NEXT_PUBLIC_WS_URL=ws://localhost:8088.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=Feed.io
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_PART_SIZE_BYTES=20971520
NEXT_PUBLIC_MULTIPART_THRESHOLD_BYTES=52428800
NEXT_PUBLIC_MAX_SINGLE_FILE_SIZE_BYTES=53687091200
NEXT_PUBLIC_MAX_CONCURRENT_PART_UPLOADS=4
NEXT_PUBLIC_WS_PING_INTERVAL_MS=25000
NEXT_PUBLIC_WS_RECONNECT_MAX_DELAY_MS=10000
NEXT_PUBLIC_GLITCHTIP_DSN=
