FEEDIO_ENVIRONMENT=development
FEEDIO_DATABASE_URL=postgresql+psycopg://feedio:replace-me@localhost:5432/feedio
FEEDIO_VALKEY_URL=redis://localhost:6379/0
FEEDIO_RABBITMQ_URL=amqp://feedio:replace-me@localhost:5672/
FEEDIO_GARAGE_ADMIN_URL=http://localhost:3903
FEEDIO_GARAGE_ADMIN_TOKEN=replace-me
FEEDIO_AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
FEEDIO_AUTH_JWT_ISSUER=feedio
FEEDIO_AUTH_ACCESS_TTL_SECONDS=300
FEEDIO_AUTH_REFRESH_TTL_SECONDS=2592000
FEEDIO_AUTH_COOKIE_SECURE=false
FEEDIO_WEB_BASE_URL=http://localhost:8088

# Email Service Configuration (Default: Local Mailpit)
# Supports: Mailpit (local), Resend, Brevo, Gmail, SendGrid, Amazon SES, Stalwart, etc.
FEEDIO_SMTP_HOST=localhost
FEEDIO_SMTP_PORT=1025
FEEDIO_SMTP_SENDER="Feed.io <no-reply@feedio.local>"
FEEDIO_SMTP_USER=
FEEDIO_SMTP_PASS=
FEEDIO_SMTP_START_TLS=false
FEEDIO_SMTP_USE_TLS=false

# Preset 1: Resend (Free 3,000 emails/month)
# FEEDIO_SMTP_HOST=smtp.resend.com
# FEEDIO_SMTP_PORT=465
# FEEDIO_SMTP_USER=resend
# FEEDIO_SMTP_PASS=re_your_api_key_here
# FEEDIO_SMTP_USE_TLS=true
# FEEDIO_SMTP_SENDER="Feed.io <onboarding@resend.dev>"

# Preset 2: Brevo / Sendinblue (Free 300 emails/day = 9,000/month)
# FEEDIO_SMTP_HOST=smtp-relay.brevo.com
# FEEDIO_SMTP_PORT=587
# FEEDIO_SMTP_USER=your_brevo_account_email@domain.com
# FEEDIO_SMTP_PASS=your_master_smtp_key_here
# FEEDIO_SMTP_START_TLS=true
# FEEDIO_SMTP_SENDER="Feed.io <verified_sender@domain.com>"

# Preset 3: Google / Gmail SMTP (Free 500 emails/day with App Password)
# FEEDIO_SMTP_HOST=smtp.gmail.com
# FEEDIO_SMTP_PORT=587
# FEEDIO_SMTP_USER=your_address@gmail.com
# FEEDIO_SMTP_PASS=your_16_char_app_password
# FEEDIO_SMTP_START_TLS=true
# FEEDIO_SMTP_SENDER="Feed.io <your_address@gmail.com>"
FEEDIO_COLLABORATION_PRESENCE_TTL_SECONDS=120
FEEDIO_CORS_ORIGINS=["http://localhost:3000","http://localhost:8088"]
FEEDIO_GARAGE_S3_ENDPOINT_URL=http://localhost:3900
FEEDIO_GARAGE_S3_BUCKET=feedio-media
FEEDIO_GARAGE_S3_ACCESS_KEY=replace-me
FEEDIO_GARAGE_S3_SECRET_KEY=replace-me
FEEDIO_GARAGE_S3_REGION=garage
FEEDIO_GARAGE_S3_CORS_ORIGINS=["http://localhost:3000","http://localhost:8088"]
NEXT_PUBLIC_API_URL=http://localhost:8088
NEXT_PUBLIC_WS_URL=ws://localhost:8088
POSTGRES_USER=feedio
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=feedio
RABBITMQ_DEFAULT_USER=feedio
RABBITMQ_DEFAULT_PASS=replace-me
GARAGE_RPC_SECRET=replace-with-64-hex-characters
GARAGE_ADMIN_TOKEN=replace-me
GARAGE_METRICS_TOKEN=replace-me
GARAGE_S3_BUCKET=feedio-media
GARAGE_S3_ACCESS_KEY=replace-me
GARAGE_S3_SECRET_KEY=replace-me
GARAGE_LOCAL_CAPACITY=10G
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
GLITCHTIP_SECRET_KEY=replace-me

# Platform Billing & Stripe Payment Configuration
FEEDIO_BILLING_PROVIDER=mock
FEEDIO_PAYMENTS_ENABLED=true
FEEDIO_STRIPE_SECRET_KEY=
FEEDIO_STRIPE_WEBHOOK_SECRET=
FEEDIO_STRIPE_PRICE_PRO_100GB_MONTHLY=
FEEDIO_STRIPE_PRICE_PRO_100GB_YEARLY=
FEEDIO_STRIPE_PRICE_PRO_500GB_MONTHLY=
FEEDIO_STRIPE_PRICE_PRO_500GB_YEARLY=
FEEDIO_STRIPE_PRICE_PRO_1TB_MONTHLY=
FEEDIO_STRIPE_PRICE_PRO_1TB_YEARLY=
