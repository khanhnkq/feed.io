{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{
            "options": {
              "0": { "color": "red", "text": "DOWN" },
              "1": { "color": "green", "text": "UP" }
            },
            "type": "value"
          }],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [{ "expr": "max(up{job=\"feedio-api\"})", "legendFormat": "API", "refId": "A" }],
      "title": "API health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{
            "options": {
              "0": { "color": "red", "text": "NOT READY" },
              "1": { "color": "green", "text": "READY" }
            },
            "type": "value"
          }],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [{ "expr": "max(feedio_worker_ready)", "legendFormat": "Worker", "refId": "A" }],
      "title": "Worker health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{
            "options": {
              "0": { "color": "red", "text": "DOWN" },
              "1": { "color": "green", "text": "UP" }
            },
            "type": "value"
          }],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [{ "expr": "max(pg_up)", "legendFormat": "PostgreSQL", "refId": "A" }],
      "title": "Database health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(feedio_http_request_duration_seconds_bucket[5m])))",
        "legendFormat": "p95",
        "refId": "A"
      }],
      "title": "API latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{ "expr": "feedio_dependency_up", "legendFormat": "{{ dependency }}", "refId": "A" }],
      "title": "Dependency probes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{ "expr": "{service=~\"api|worker\"}", "refId": "A" }],
      "title": "API and worker logs",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["feedio", "self-hosted"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Feed.io Runtime Overview",
  "uid": "feedio-runtime",
  "version": 1
}
